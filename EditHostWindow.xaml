<Window x:Class="ConnectionChecker.EditHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target"
        Width="420" SizeToContent="Height"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="ADD TARGET"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,18"/>

            <TextBlock Text="DISPLAY NAME" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource NeonTextBox}" Margin="0,0,0,14"/>

            <TextBlock Text="HOST / IP ADDRESS" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="AddressBox" Style="{StaticResource NeonTextBox}"
                     FontFamily="Consolas"/>
            <TextBlock Text="Special values: {gateway} = default gateway, {dns} = DNS server"
                       Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,14"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CHECK METHOD" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TypeCombo" Style="{StaticResource NeonCombo}"
                              SelectionChanged="TypeCombo_SelectionChanged">
                        <ComboBoxItem Content="TCP port" IsSelected="True"/>
                        <ComboBoxItem Content="ICMP ping"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" x:Name="PortPanel">
                    <TextBlock Text="PORT" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PortBox" Style="{StaticResource NeonTextBox}"
                             Text="443" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="INTERVAL (S)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="IntervalBox" Style="{StaticResource NeonTextBox}"
                             Text="30" FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="RETRIES" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RetryBox" Style="{StaticResource NeonTextBox}"
                             Text="1" FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="TIMEOUT (MS)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TimeoutBox" Style="{StaticResource NeonTextBox}"
                             Text="4000" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="ActiveCheck" Style="{StaticResource NeonCheck}"
                      Content="Active — untick to pause checks for this target"
                      IsChecked="True" Margin="0,14,0,0"/>

            <CheckBox x:Name="SoundCheck" Style="{StaticResource NeonCheck}"
                      Content="Play a subtle ping when an alert appears"
                      IsChecked="True" Margin="0,10,0,0"/>

            <TextBlock Text="TILE COLOURS (BLANK = USE GLOBAL SETTING)" Style="{StaticResource FieldLabel}"
                       Margin="0,16,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Offline" Foreground="{StaticResource TextBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="OfflineColorBox" Style="{StaticResource NeonTextBox}"
                         FontFamily="Consolas" TextChanged="ColorBox_TextChanged"/>
                <Border Grid.Row="0" Grid.Column="2" x:Name="OfflineSwatch" Width="26" Height="26" CornerRadius="3"
                        Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Cursor="Hand" ToolTip="Click to pick a colour"
                        MouseLeftButtonUp="OfflineSwatch_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Online" Foreground="{StaticResource TextBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="OnlineColorBox" Style="{StaticResource NeonTextBox}"
                         FontFamily="Consolas" Margin="0,10,0,0" TextChanged="ColorBox_TextChanged"/>
                <Border Grid.Row="1" Grid.Column="2" x:Name="OnlineSwatch" Width="26" Height="26" CornerRadius="3"
                        Margin="8,10,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Cursor="Hand" ToolTip="Click to pick a colour"
                        MouseLeftButtonUp="OnlineSwatch_Click"/>
            </Grid>
            <TextBlock Text="Click a swatch to pick a colour."
                       Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,6,0,0"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource OfflineBrush}"
                       FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="SAVE" Style="{StaticResource NeonButton}"
                        Click="Save_Click" IsDefault="True"/>
                <Button Content="CANCEL" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                        Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
