<Window x:Class="ConnectionChecker.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Width="780" Height="520"
        MinWidth="620" MinHeight="320"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Shared by the column header and the rows so they line up. -->
        <Style x:Key="ColLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="EventText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource OnlineBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Event}" Value="OFFLINE">
                    <Setter Property="Foreground" Value="{StaticResource OfflineBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="14,7"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,22,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="HISTORY" Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextDimBrush}"
                       FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===== Table ===== -->
        <Border Grid.Row="1" Background="#0C1220" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBrush}" Padding="14,9"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="3,3,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource ColLabel}"/>
                        <TextBlock Grid.Column="1" Text="TARGET" Style="{StaticResource ColLabel}"/>
                        <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource ColLabel}"/>
                        <TextBlock Grid.Column="3" Text="EVENT" Style="{StaticResource ColLabel}"/>
                        <TextBlock Grid.Column="4" Text="REASON" Style="{StaticResource ColLabel}"/>
                    </Grid>
                </Border>

                <ListBox x:Name="EventList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource HistoryRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Target}"
                                           Foreground="{StaticResource TextBrush}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Type}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Event}" Style="{StaticResource EventText}"/>
                                <TextBlock Grid.Column="4" Text="{Binding Reason}"
                                           Foreground="{StaticResource OfflineBrush}"
                                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Grid.Row="1"
                           Text="Nothing has gone offline since the app started."
                           Foreground="{StaticResource TextDimBrush}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== Footer ===== -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Kept in memory until PULSE//WATCH exits; removed targets keep their events."
                       Foreground="{StaticResource TextDimBrush}" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,200,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExportButton" Content="EXPORT CSV" Style="{StaticResource NeonButton}"
                        Click="Export_Click"/>
                <Button Content="CLOSE" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Click="Close_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
