<Window x:Class="ConnectionChecker.AlertOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseWatch Alerts"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        FontFamily="Segoe UI">

    <!-- The window is only as tall as its tiles and is hidden when there are
         none: a permanent full-height strip, even fully transparent, swallows
         mouse input in DirectX games running maximised-windowed. -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
        <StackPanel x:Name="AlertHost" Width="340" Margin="0,16,16,16"
                    HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </ScrollViewer>
</Window>
